  "strengths": [
    "Drop-in compatible with Redis OSS 7.2 clients, commands and RDB/AOF files",
    "BSD-3-Clause license with open governance and no CLA-backed relicensing risk",
    "Multi-threaded I/O delivers well over 1M requests/s on one node",
    "Default engine for ElastiCache, MemoryDB and Memorystore, often at lower price than Redis OSS",
    "Hash field expiration and database-level ACLs added beyond the original fork"
  ],
  "weaknesses": [
    "Search, JSON and Bloom features live in separate valkey-search/valkey-json/valkey-bloom modules",
    "Diverging from Redis 8 commands, so new Redis-only features will not appear",
    "Still memory-bound: dataset size equals RAM bill",
    "Async replication can drop recent writes on failover"
  ],
  "useCases": [
    "Replacing Redis OSS without license concerns",
    "Application caching and session storage",
    "Rate limiting, counters and leaderboards",
    "Pub/sub fan-out and Streams-based queues"
  ],
  "notIdealFor": [
