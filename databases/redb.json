  "strengths": [
    "Pure Rust with zero unsafe-heavy C dependencies",
    "Fully ACID with MVCC: readers never block the writer",
    "Typed tables and multimap tables in a natural Rust API",
    "Stable file format with upgrade paths between major versions",
    "Savepoints and crash safety without a separate WAL"
  ],
  "weaknesses": [
    "Single writer at a time",
    "Write throughput below LSM engines for heavy random writes",
    "Essentially a one-maintainer project",
    "Rust-first; other language bindings are minimal"
  ],
