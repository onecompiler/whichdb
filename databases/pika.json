  "strengths": [
    "Disk-based storage keeps cost low for large Redis-style datasets",
    "Fast restarts and replication compared with huge in-memory Redis instances",
    "Hot-data cache layer in front of RocksDB",
    "Long production history at Qihoo 360 and other Chinese internet companies"
  ],
  "weaknesses": [
    "Higher latency than RAM-only Redis",
    "Clustering relies on Codis rather than native Redis Cluster",
    "English documentation and community support are limited",
    "Incomplete coverage of newer Redis commands"
  ],
  "useCases": [
    "Large persistent key-value data behind a Redis API",
    "Cutting memory cost of oversized Redis deployments"
