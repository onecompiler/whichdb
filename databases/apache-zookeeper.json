  "strengths": [
    "Ephemeral and sequential znodes make leader election and locks straightforward",
    "Totally ordered writes with sequential consistency for clients",
    "Mature recipe library (Apache Curator)",
    "Deep integration with Hadoop, HBase, Solr, Pulsar and others"
  ],
  "weaknesses": [
    "Whole dataset lives in memory on every member; 1 MB znode limit",
    "Session and GC tuning issues cause hard-to-debug outages",
    "Declining adoption: Kafka dropped it and new systems prefer etcd",
    "Watches are one-shot unless using persistent watches (3.6+)"
  ],
  "useCases": [
    "Coordination for HBase, Solr, Pulsar and legacy Kafka",
    "Leader election and distributed locks for JVM services",
    "Cluster membership and small shared configuration"
  ],
