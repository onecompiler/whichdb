  "strengths": [
    "Rock-solid ACID semantics and SQL standards compliance",
    "Huge extension ecosystem: PostGIS, pgvector, TimescaleDB, Citus, pg_duckdb",
    "JSONB gives document-store flexibility inside a relational database",
    "Available as a managed service on virtually every cloud",
    "Permissive license with no single-vendor control"
  ],
  "weaknesses": [
    "No built-in horizontal write scaling",
    "Process-per-connection model needs a pooler (PgBouncer) at high concurrency",
    "VACUUM and bloat management require operational care",
    "Major-version upgrades need pg_upgrade or logical replication"
  ],
  "useCases": [
    "General-purpose application backend",
    "SaaS multi-tenant data",
    "Geospatial applications with PostGIS",
    "Semantic search alongside relational data with pgvector",
    "Financial and inventory systems needing strict integrity"
  ],
  "notIdealFor": [
    "Petabyte-scale analytics (use a columnar warehouse)",
    "Ultra-low-latency caching",
    "Massive write fan-out across regions"
